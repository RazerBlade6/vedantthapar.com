---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Terminal from '../components/Terminal.astro';
import Footer from '../components/Footer.astro';
import { site, THEMES } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Path shown in the status line, e.g. "~/projects/apex.md" */
  file: string;
  /** Social preview image under /og/, e.g. "projects/apex" (see pages/og) */
  og?: string;
}

const { title, description = site.description, file, og = 'index' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — AI engineer`;
// with build.format 'file', Astro reports "/index.html" and "/projects/apex.html"; the site serves clean URLs
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(path, site.url);
const ogImage = new URL(`/og/${og}.png`, site.url);
const isHome = path === '/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'AI Engineer',
  description: site.description,
  sameAs: [site.github, site.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title ?? site.name} — ${description}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {isHome && <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />}

    <!-- Pre-paint theme + effects: stored choice, else system preference. Re-applied after client-side navigation. -->
    <script is:inline define:vars={{ themes: THEMES }}>
      (function () {
        var light = matchMedia('(prefers-color-scheme: light)');
        function pick() {
          var t;
          // ?theme=<name> picks (and remembers) a theme — handy for sharing a specific look
          var q = new URLSearchParams(location.search).get('theme');
          try {
            if (themes.indexOf(q) >= 0) localStorage.setItem('theme', q);
            t = localStorage.getItem('theme');
          } catch (e) {
            t = q;
          }
          return themes.indexOf(t) >= 0 ? t : light.matches ? 'paper' : 'gruvbox';
        }
        // CRT effects: stored choice, else on — unless the system asks for reduced motion
        function effects() {
          var e;
          try { e = localStorage.getItem('effects'); } catch (err) {}
          return e === 'on' || e === 'off' ? e : matchMedia('(prefers-reduced-motion: reduce)').matches ? 'off' : 'on';
        }
        function effectsOff() {
          try { return localStorage.getItem('effects-off') || ''; } catch (err) { return ''; }
        }
        function apply() {
          document.documentElement.dataset.theme = pick();
          document.documentElement.dataset.effects = effects();
          document.documentElement.dataset.fxOff = effectsOff();
        }
        apply();
        if (!window.__themeBound) {
          window.__themeBound = true;
          document.addEventListener('astro:after-swap', apply);
          light.addEventListener('change', apply);
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-bg-alt focus:px-3 focus:py-2"
      >Skip to content</a
    >
    <main id="main" data-file={file} class="mx-auto w-full max-w-[640px] flex-1 px-4 pt-20 pb-16 sm:px-6 sm:pt-28">
      <slot />
    </main>
    <Footer />
    <Terminal file={file} />
  </body>
</html>
