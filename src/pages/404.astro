---
import Base from '../layouts/Base.astro';
import { site } from '../site';

const entries = [
  { href: '/', name: 'index.md' },
  { href: '/#projects', name: 'projects/' },
  { href: '/#experience', name: 'experience.log' },
  { href: '/#about', name: 'about.txt' },
  { href: '/#contact', name: 'contact' },
  ...(site.resume ? [{ href: site.resume, name: 'resume.pdf' }] : []),
];
---

<Base title="Not found" description="This page doesn't exist." file="[No Name]">
  <h1 class="sr-only">Page not found</h1>
  <div class="font-mono text-sm leading-7">
    <p><span class="text-accent">~ $</span> cd <span data-path>this-page</span></p>
    <p class="text-fg-strong">bash: cd: <span data-path>this-page</span>: No such file or directory</p>
    <p class="mt-4"><span class="text-accent">~ $</span> ls</p>
    <ul class="flex flex-wrap gap-x-6">
      {
        entries.map((e) => (
          <li>
            <a href={e.href}>{e.name}</a>
          </li>
        ))
      }
    </ul>
    <p class="mt-4"><span class="text-accent">~ $</span> <span class="cursor-block" aria-hidden="true"></span></p>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const path = decodeURIComponent(location.pathname);
    document.querySelectorAll('[data-path]').forEach((el) => (el.textContent = path));
  });
</script>
