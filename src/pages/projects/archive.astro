---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const archived = (await getCollection('projects', (p) => !p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Archive" description="Other projects by Vedant Thapar." file="~/projects/archive/" og="projects/archive">
  <p class="label mb-8"><a href="/#projects">cd ..</a></p>
  <h1 class="text-3xl font-semibold tracking-tight text-fg-strong">Archive</h1>
  <p class="mt-4 leading-relaxed">Smaller, older or unfinished — but each taught me something.</p>

  <ul class="mt-10 border-b border-border">
    {
      archived.map((p) => (
        <li id={p.id} class="flex scroll-mt-8 flex-col gap-1 border-t border-border py-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h2 class="font-medium text-fg-strong">{p.data.title}</h2>
            <span class="label">{p.data.stack.join(' · ')}</span>
          </div>
          <p class="text-sm leading-relaxed">{p.data.summary}</p>
          {(p.data.repo || p.data.status) && (
            <p class="label mt-1 flex gap-4">
              {p.data.status && <span>{p.data.status}</span>}
              {p.data.repo && <a href={p.data.repo}>source</a>}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
